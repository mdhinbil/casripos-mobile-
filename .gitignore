# Buildozer / python-for-android build output
bin/
.buildozer/
__pycache__/
*.pyc

# Local deploy zips (web app packaging, not needed for the APK build)
*.zip

# NEVER commit the signing key — it lives in GitHub secrets only
*.keystore
*.jks
keystore/

# OS junk
Thumbs.db
.DS_Store

# Flutter build output. `flutter test` and `flutter build` create these; they
# are machine-specific and were briefly committed by accident.
flutter_app/.dart_tool/
flutter_app/build/
flutter_app/.flutter-plugins-dependencies
